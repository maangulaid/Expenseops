cat > .env.example << 'EOF'
# -----------------------------
# Project
# -----------------------------
PROJECT_NAME=expenseops
ENV=local

# -----------------------------
# Postgres
# -----------------------------
POSTGRES_DB=expenseops
POSTGRES_USER=expenseops
POSTGRES_PASSWORD=expenseops_pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# For local connections from your machine:
POSTGRES_HOST_LOCAL=localhost

# SQLAlchemy/Alembic-style URL (used later in Phase 2/3)
DATABASE_URL=postgresql+psycopg://expenseops:expenseops_pw@postgres:5432/expenseops

# -----------------------------
# Redis
# -----------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery (later)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -----------------------------
# MinIO (S3-compatible)
# -----------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_pw

MINIO_ENDPOINT=http://minio:9000
MINIO_CONSOLE_ENDPOINT=http://localhost:9001

MINIO_DEFAULT_BUCKET=receipts-raw
MINIO_REGION=us-east-1

# S3 client config used by API/worker later
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_pw
S3_BUCKET_RECEIPTS_RAW=receipts-raw
S3_SECURE=false

# If you later generate presigned URLs, you may need an external base:
S3_PUBLIC_ENDPOINT=http://localhost:9000

# -----------------------------
# JWT / Security
# -----------------------------
SECRET_KEY=your-secret-key-change-in-production-please-use-strong-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------
# File Upload
# -----------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# -----------------------------
# Celery Worker
# -----------------------------
CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_BASE=60

# -----------------------------
# Logging
# -----------------------------
LOG_LEVEL=INFO

# -----------------------------
# CORS (for frontend)
# -----------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
